{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Browser Agent Workflow Schema",
  "type": "object",
  "required": ["version", "name", "actions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Workflow format version (e.g., 1.0.0)"
    },
    "name": {
      "type": "string",
      "description": "Workflow name"
    },
    "description": {
      "type": "string",
      "description": "Workflow description"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "creator": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "enum": ["string", "number", "boolean", "file"]
          },
          "required": { "type": "boolean", "default": true },
          "description": { "type": "string" },
          "default": {},
          "fileType": {
            "type": "string",
            "description": "For file type: xlsx, csv, pdf, etc"
          },
          "options": {
            "type": "array",
            "description": "For enum values"
          }
        }
      }
    },
    "globalSettings": {
      "type": "object",
      "properties": {
        "autoDismissPopup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "mode": { "enum": ["smart", "manual"], "default": "smart" },
            "selectors": { "type": "array", "items": { "type": "string" } },
            "timeout": { "type": "number", "default": 2000 },
            "retryCount": { "type": "number", "default": 2 }
          }
        },
        "handleBrowserAlerts": {
          "type": "object",
          "properties": {
            "alert": { "enum": ["accept", "dismiss"] },
            "confirm": { "enum": ["accept", "dismiss"] },
            "prompt": { "enum": ["accept", "dismiss"] }
          }
        },
        "defaultTimeout": { "type": "number", "default": 10000 },
        "defaultWaitTime": { "type": "number", "default": 1000 }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": [
              "navigate",
              "click",
              "input",
              "select",
              "uploadFile",
              "wait",
              "waitForSelector",
              "extractTable",
              "extractJson",
              "extractText",
              "dismissPopup",
              "hover",
              "screenshot",
              "scroll",
              "batchInput",
              "batchClick",
              "batchSearch",
              "batchExtract",
              "mailSend",
              "mailRead",
              "mailSearch",
              "mailAttachment",
              "fileReadExcel",
              "fileWriteExcel",
              "fileReadPdf",
              "fileMove",
              "dbQuery",
              "dbExecute",
              "dbExport",
              "apiGet",
              "apiPost",
              "apiJsonParse"
            ]
          },
          "url": { "type": "string", "description": "navigate/apiGet/apiPost: target URL" },
          "selector": { "type": "string", "description": "CSS or XPath selector" },
          "selectors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Candidate selectors for dismissPopup"
          },
          "selectorFallbacks": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Alternative selectors tried in order when the main one no longer matches"
          },
          "value": { "type": "string", "description": "Value to input/select" },
          "filename": { "type": "string", "description": "Output file for screenshot action" },
          "position": {
            "enum": ["top", "bottom", "center"],
            "description": "Scroll target position"
          },
          "pixels": { "type": "number", "description": "Scroll distance in pixels" },
          "path": { "type": "string", "description": "extractJson/apiJsonParse: dotted path into the parsed JSON" },
          "duration": { "type": "number", "description": "Wait duration in ms" },
          "timeout": { "type": "number", "description": "Max wait time in ms" },
          "headers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Column headers for table extraction"
          },
          "output": { "type": "string", "description": "Variable name to store result" },
          "waitBefore": { "type": "number", "description": "Wait before action (ms)" },
          "waitAfter": { "type": "number", "description": "Wait after action (ms)" },
          "retry": {
            "type": "object",
            "properties": {
              "count": { "type": "number" },
              "delayMs": { "type": "number" }
            }
          },
          "onError": { "enum": ["fail", "skip", "ignore"], "default": "fail" },
          "note": { "type": "string", "description": "User-facing label for this step, display only" },
          "framework": {
            "enum": ["nexacro", "websquare"],
            "description": "Framework that rendered the element when recorded, absent for plain HTML. Metadata only, never read during replay"
          },
          "inputType": { "enum": ["text", "fileUpload", "select"], "description": "Batch Input element kind" },
          "column": { "type": "string", "description": "Dataset column a Batch Input reads its value from" },
          "replaceMode": {
            "enum": ["replace", "append", "keepExisting"],
            "default": "replace",
            "description": "How a Batch Input treats the field's existing value"
          },
          "waitCondition": {
            "type": "object",
            "required": ["type", "timeout"],
            "properties": {
              "type": { "enum": ["elementAppears"] },
              "selector": { "type": "string" },
              "timeout": { "type": "number" }
            },
            "description": "Batch Search: how to detect the result is ready"
          },
          "extractType": {
            "enum": ["text", "attribute", "value"],
            "description": "Batch Extract: what to read off the element"
          },
          "attribute": { "type": "string", "description": "Attribute name, required when extractType is 'attribute'" },

          "host": { "type": "string", "description": "Mail: SMTP/IMAP host" },
          "port": { "type": "number", "description": "Mail: SMTP/IMAP port" },
          "secure": { "type": "boolean", "description": "Mail: use TLS" },
          "user": { "type": "string", "description": "Mail: account username" },
          "password": { "type": "string", "description": "Mail: account password" },
          "to": { "type": "string", "description": "mailSend: recipient(s)" },
          "cc": { "type": "string" },
          "bcc": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string", "description": "mailSend: message body" },
          "html": { "type": "boolean", "description": "mailSend: whether body is HTML" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["filePath"],
              "properties": {
                "filePath": { "type": "string" },
                "filename": { "type": "string" }
              }
            },
            "description": "mailSend: files to attach"
          },
          "mailbox": { "type": "string", "description": "mailRead/mailSearch: IMAP folder, defaults to INBOX" },
          "criteria": { "enum": ["all", "unseen"], "description": "mailRead: which messages to fetch" },
          "limit": { "type": "number", "description": "mailRead/mailSearch: max messages to return" },
          "markSeen": { "type": "boolean", "description": "mailRead: mark matched messages as read" },
          "from": { "type": "string", "description": "mailSearch: sender filter" },
          "since": { "type": "string", "description": "mailSearch: ISO date lower bound" },
          "unseen": { "type": "boolean", "description": "mailSearch: only unread messages" },
          "source": { "type": "string", "description": "mailAttachment: variable holding the mailRead/mailSearch result" },
          "saveDir": { "type": "string", "description": "mailAttachment: directory to save attachments into" },

          "filePath": { "type": "string", "description": "File/Database: path to read, write, or export" },
          "sheet": {
            "anyOf": [{ "type": "string" }, { "type": "number" }],
            "description": "fileReadExcel/fileWriteExcel: sheet name or index"
          },
          "headerRow": { "type": "boolean", "description": "fileReadExcel/fileWriteExcel: treat/write first row as column names" },
          "data": { "type": "string", "description": "fileWriteExcel: variable holding the rows to write" },
          "sourcePath": { "type": "string", "description": "fileMove: source path" },
          "destPath": { "type": "string", "description": "fileMove: destination path" },
          "overwrite": { "type": "boolean", "description": "fileMove: overwrite an existing file at destPath" },

          "connection": {
            "type": "object",
            "required": ["server", "database", "user", "password"],
            "properties": {
              "server": { "type": "string" },
              "database": { "type": "string" },
              "user": { "type": "string" },
              "password": { "type": "string" },
              "port": { "type": "number" },
              "encrypt": { "type": "boolean" },
              "trustServerCertificate": { "type": "boolean" }
            },
            "description": "Database: SQL Server connection"
          },
          "query": { "type": "string", "description": "dbQuery/dbExport: SQL to run" },
          "params": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] },
            "description": "Database: positional bind parameters"
          },
          "statement": { "type": "string", "description": "dbExecute: SQL to run" },
          "format": { "enum": ["csv", "excel", "json"], "description": "dbExport: output file format" },

          "httpHeaders": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "apiGet/apiPost: request headers"
          },
          "queryParams": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "apiGet: URL query parameters"
          },
          "json": { "type": "boolean", "description": "apiPost: send body as application/json" },
          "input": { "type": "string", "description": "apiJsonParse: variable holding the raw JSON string" }
        },
        "additionalProperties": false
      }
    },
    "exportFormats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "output", "dataKey"],
        "properties": {
          "type": { "enum": ["excel", "csv", "json"] },
          "output": { "type": "string" },
          "dataKey": { "type": "string" }
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["type", "fileName"],
      "properties": {
        "type": { "enum": ["excel"] },
        "fileName": { "type": "string" }
      },
      "description": "Label only — the actual dataset is attached at run time"
    },
    "nexacroReplayGuide": {
      "type": "object",
      "required": ["readme", "bridgeScript"],
      "properties": {
        "readme": { "type": "string" },
        "bridgeScript": { "type": "string" }
      },
      "description": "Present only when actions contains a nexacro:<id> selector — everything another program needs to replay those steps without this project's own source or CLI"
    }
  },
  "additionalProperties": false
}
