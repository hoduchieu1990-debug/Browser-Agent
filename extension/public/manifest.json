{
  "manifest_version": 3,
  "name": "Browser Agent Recorder",
  "version": "0.1.0",
  "description": "Record browser actions and export them as a Browser Agent workflow.",
  "action": {
    "default_title": "Browser Agent — dock the panel on this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Hide or show the Browser Agent panel"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "downloads", "debugger"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
