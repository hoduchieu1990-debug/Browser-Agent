{
  "manifest_version": 3,
  "name": "Browser Agent Recorder",
  "version": "0.1.0",
  "description": "Record browser actions and export them as a Browser Agent workflow.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "popup.html?side=1"
  },
  "web_accessible_resources": [
    {
      "resources": ["nexacro-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "webNavigation", "downloads", "debugger", "sidePanel"],
  "host_permissions": ["<all_urls>"]
}
