{
  "name": "@browser-agent/extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run generate-icons && webpack --mode production",
    "dev": "npm run generate-icons && webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@browser-agent/shared": "0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "copy-webpack-plugin": "^12.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/chrome": "^0.0.263"
  }
}
